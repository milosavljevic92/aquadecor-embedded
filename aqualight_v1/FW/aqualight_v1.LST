00008E 6EE9           03360         movwf   FSR0L           ; 1
000090 88E9           03361         bsf     FSR0L, 4        ; 1
000092 500D           03362         movf    RM1, W          ; 1
000094 12EC           03363 i2chigh iorwf   PREINC0, F      ; 1 Set high (input)
000096 D008           03364         bra     i2chl           ; 2
                      03365 
000098 C011 FFEA      03366 i2cdal  movff   RS1, FSR0H      ; 2 (10) Get pointer to data pin
