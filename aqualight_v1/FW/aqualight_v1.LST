00005C 8400           03334         bsf     I2CFIRSTFLAG    ; Indicate not first anymore
00005E 90D8           03335         bcf     STATUS, C       ; Clear carry for OK return
000060 D00A           03336         bra     i2cwritedone    ; That's it for now
                      03337 
000062 B800           03338 i2cwrite2 btfsc I2CWRITEFLAG    ; Already writing?
