                      03235   LIST
00001C 8A00           03236 I2CREADS bsf    I2CSTOPFLAG     ; Indicate Stop after this byte
00001E AA00           03237         btfss   I2CSTOPFLAG     ; Skip next always
000020 9A00           03238 I2CREAD bcf     I2CSTOPFLAG     ; Don't Stop
000022 B600           03239         btfsc   I2CREADFLAG     ; Already reading?
000024 D003           03240         bra     i2creadip       ; Yes
000026 8600           03241         bsf     I2CREADFLAG     ; Indicate read
000028 D840           03242         rcall   i2cstart        ; Send Start condition and command
00002A E227           03243         bc      i2cstop         ; No acknowledge
                      03244 
00002C 0E08           03245 i2creadip movlw 8               ; 8 bits to a byte
00002E 6E1F           03246         movwf   R1 + 1          ; Bit counter
000030 D850           03247 i2creadloop rcall i2cgetbit     ; Get a bit
000032 361E           03248         rlcf    R1, F           ; Put bit away
000034 2E1F           03249         decfsz  R1 + 1, F       ; Do next, if any
000036 D7FC           03250         bra     i2creadloop
000038 AA00           03251         btfss   I2CSTOPFLAG     ; Send stop?
00003A D82E           03252         rcall   i2cdal          ; No, send acknowledge
00003C D858           03253         rcall   i2cckh          ; Toggle clock in any case
00003E D851           03254         rcall   i2cckl
000040 BA00           03255         btfsc   I2CSTOPFLAG     ; Send stop?
000042 D81B           03256         rcall   i2cstop         ; Yes, send Stop condition
000044 D821           03257         rcall   i2cdah          ; Make sure data ends up as input
000046 501E           03258         movf    R1, W           ; Get result to W
000048 90D8           03259         bcf     STATUS, C       ; Clear carry for OK return
00004A EFB5 F002      03260 i2creaddone goto DUNN
                      03326   LIST
00004E 8A00           03327 I2CWRITES bsf   I2CSTOPFLAG     ; Indicate Stop after this byte
000050 AA00           03328         btfss   I2CSTOPFLAG     ; Skip next always
000052 9A00           03329 I2CWRITE bcf    I2CSTOPFLAG     ; Don't Stop
000054 B400           03330         btfsc   I2CFIRSTFLAG    ; Check for first I2C char (command)
000056 D005           03331         bra     i2cwrite2       ; No
