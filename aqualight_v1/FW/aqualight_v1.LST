000072 E203           03346         bc      i2cstop         ; No acknowledge
000074 AA00           03347         btfss   I2CSTOPFLAG     ; Send stop bit?
000076 EFB5 F002      03348 i2cwritedone goto DUNN          ; No
                      03349 
00007A D80E           03350 i2cstop rcall   i2cdal          ; 12 Start data low
00007C D838           03351         rcall   i2cckh          ; 15 Set clock high (input)
00007E 9400           03352         bcf     I2CFIRSTFLAG    ; 1 Reset first char flag
000080 9800           03353         bcf     I2CWRITEFLAG    ; 1 No longer writing
