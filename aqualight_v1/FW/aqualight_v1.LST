0000A0 1C0D           03368         comf    RM1, W          ; 1
0000A2 16EE           03369 i2clow  andwf   POSTINC0, F     ; 1 Set low, start pointing to TRIS
0000A4 88E9           03370         bsf     FSR0L, 4        ; 1
0000A6 16EC           03371         andwf   PREINC0, F      ; 1 Set to output
0000A8                03372 i2chl
                      03373       ifndef I2C_SLOW
0000A8 0012           03374         return                  ; 2
