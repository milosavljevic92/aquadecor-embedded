                      00092   LIST
                      00093 ; Oscillator is 20MHz
                      01447   LIST
000000                01448     ORG RESET_ORG               ; Reset vector at 0
                      01452   LIST
000000 6A00           01453         CLRF    FLAGS           ; Clear all flags on reset
                      01457   LIST
000002 EFB7 F002      01458         GOTO    INIT            ; Finish initialization
                      01468   LIST
000008                01469     ORG RESET_ORG + 8           ; High priority interrupt vector at 8
000008 EF2A F003      01470         GOTO    INTHAND         ; Goto high priority user interrupt handler
                      01482   LIST
000018                01483     ORG RESET_ORG + 18H         ; Low priority interrupt vector at 18h
000018 EFBA F002      01484         GOTO    INTLHAND        ; Goto low priority user interrupt handler
                      02965   LIST
00001C 8A00           02966 I2CREADS BSF    I2CSTOPFLAG     ; Indicate Stop after this byte
00001E AA00           02967         BTFSS   I2CSTOPFLAG     ; Skip next always
000020 9A00           02968 I2CREAD BCF     I2CSTOPFLAG     ; Don't Stop
000022 B600           02969         BTFSC   I2CREADFLAG     ; Already reading?
000024 D003           02970         BRA     I2CREADIP       ; Yes
000026 8600           02971         BSF     I2CREADFLAG     ; Indicate read
000028 D840           02972         RCALL   I2CSTART        ; Send Start condition and command
00002A E227           02973         BC      I2CSTOP         ; No acknowledge
                      02974 
00002C 0E08           02975 I2CREADIP MOVLW 8               ; 8 bits to a byte
00002E 6E1F           02976         MOVWF   R1 + 1          ; Bit counter
000030 D850           02977 I2CREADLOOP RCALL I2CGETBIT     ; Get a bit
000032 361E           02978         RLCF    R1, F           ; Put bit away
000034 2E1F           02979         DECFSZ  R1 + 1, F       ; Do next, if any
000036 D7FC           02980         BRA     I2CREADLOOP
000038 AA00           02981         BTFSS   I2CSTOPFLAG     ; Send stop?
00003A D82E           02982         RCALL   I2CDAL          ; No, send acknowledge
00003C D858           02983         RCALL   I2CCKH          ; Toggle clock in any case
00003E D851           02984         RCALL   I2CCKL
000040 BA00           02985         BTFSC   I2CSTOPFLAG     ; Send stop?
000042 D81B           02986         RCALL   I2CSTOP         ; Yes, send Stop condition
000044 D821           02987         RCALL   I2CDAH          ; Make sure data ends up as input
000046 501E           02988         MOVF    R1, W           ; Get result to W
000048 90D8           02989         BCF     STATUS, C       ; Clear carry for OK return
