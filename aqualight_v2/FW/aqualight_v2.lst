0000A0 1C0D           03098         COMF    RM1, W          ; 1
0000A2 16EE           03099 I2CLOW  ANDWF   POSTINC0, F     ; 1 Set low, start pointing to TRIS
0000A4 88E9           03100         BSF     FSR0L, 4        ; 1
0000A6 16EC           03101         ANDWF   PREINC0, F      ; 1 Set to output
0000A8                03102 I2CHL
