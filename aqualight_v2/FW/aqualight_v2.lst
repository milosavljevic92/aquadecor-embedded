                      03056   LIST
00004E 8A00           03057 I2CWRITES BSF   I2CSTOPFLAG     ; Indicate Stop after this byte
000050 AA00           03058         BTFSS   I2CSTOPFLAG     ; Skip next always
000052 9A00           03059 I2CWRITE BCF    I2CSTOPFLAG     ; Don't Stop
000054 B400           03060         BTFSC   I2CFIRSTFLAG    ; Check for first I2C char (command)
000056 D005           03061         BRA     I2CWRITE2       ; No
000058 0BFE           03062         ANDLW   0FEH            ; Make sure r/w bit clear
00005A 6E01           03063         MOVWF   GOP             ; Save command
00005C 8400           03064         BSF     I2CFIRSTFLAG    ; Indicate not first anymore
00005E 90D8           03065         BCF     STATUS, C       ; Clear carry for OK return
000060 D00A           03066         BRA     I2CWRITEDONE    ; That's it for now
                      03067 
000062 B800           03068 I2CWRITE2 BTFSC I2CWRITEFLAG    ; Already writing?
000064 D005           03069         BRA     I2CWRITEIP      ; Yes
000066 6E26           03070         MOVWF   R3              ; Save char
000068 8800           03071         BSF     I2CWRITEFLAG    ; Indicate write
00006A D81F           03072         RCALL   I2CSTART        ; Send Start condition and command
00006C E206           03073         BC      I2CSTOP         ; No acknowledge
00006E 5026           03074         MOVF    R3, W           ; Get char back
000070 D823           03075 I2CWRITEIP RCALL I2CWRITEC      ; Write character
000072 E203           03076         BC      I2CSTOP         ; No acknowledge
000074 AA00           03077         BTFSS   I2CSTOPFLAG     ; Send stop bit?
000076 EFB4 F002      03078 I2CWRITEDONE GOTO DUNN          ; No
                      03079 
00007A D80E           03080 I2CSTOP RCALL   I2CDAL          ; 12 Start data low
00007C D838           03081         RCALL   I2CCKH          ; 15 Set clock high (input)
00007E 9400           03082         BCF     I2CFIRSTFLAG    ; 1 Reset first char flag
000080 9800           03083         BCF     I2CWRITEFLAG    ; 1 No longer writing
000082 9600           03084         BCF     I2CREADFLAG     ; 1 No longer reading either
000084 D801           03085         RCALL   I2CDAH          ; Set data high (input)
000086 D7F7           03086         BRA     I2CWRITEDONE
                      03087 
000088 C011 FFEA      03088 I2CDAH  MOVFF   RS1, FSR0H      ; 2 (11) Get pointer to data pin
00008C 3C0F           03089         INCFSZ  RR1, W          ; 1 Point to TRIS (never skip, doesn't change flags)
00008E 6EE9           03090         MOVWF   FSR0L           ; 1
000090 88E9           03091         BSF     FSR0L, 4        ; 1
000092 500D           03092         MOVF    RM1, W          ; 1
