0000AE 6E17           03397         movwf   R1 + 1          ; 1 Bit counter
0000B0 3616           03398 i2cwriteloop rlcf R1, F         ; 1 Get a bit to send
0000B2 B0D8           03399         btfsc   STATUS, C       ; 1 / 2 Skip if no bit
0000B4 DFDE           03400         rcall   i2cdah          ; 13 / 0 Set bit high (input)
0000B6 A0D8           03401         btfss   STATUS, C       ; 1 / 2 Skip if bit
0000B8 DFE4           03402         rcall   i2cdal          ; 12 / 0 Set bit low
0000BA D812           03403         rcall   i2cckh          ; 15 Set clock high (input)
0000BC D80B           03404         rcall   i2cckl          ; 14 Set clock low
0000BE 2E17           03405         decfsz  R1 + 1, F       ; 1 / 2 Do next bit, if any
0000C0 D7F7           03406         bra     i2cwriteloop    ; 2
0000C2 DFD7           03407         rcall   i2cdah          ; 13 Make sure data high (input)
                      03408 ;       bra     i2cgetbit       ; Get acknowledge (fall through)
                      03409 
0000C4 D80D           03410 i2cgetbit rcall i2cckh          ; 15 (34) Set clock high
0000C6 C010 FFEA      03411         movff   RS1, FSR0H      ; 2 Point to data pin
0000CA C00E FFE9      03412         movff   RR1, FSR0L      ; 2
0000CE 500C           03413         movf    RM1, W          ; 1
0000D0 14EF           03414         andwf   INDF0, W        ; 1 Isolate pin
0000D2 0FFF           03415         addlw   -1              ; 1 Move bit to carry
                      03416 ;       bra     i2cckl          ; Set clock low (fall through)
                      03417 
0000D4 C011 FFEA      03418 i2cckl  movff   RS2, FSR0H      ; 2 (12) Get pointer to clock pin
0000D8 C00F FFE9      03419         movff   RR2, FSR0L      ; 2
0000DC 1C0D           03420         comf    RM2, W          ; 1
0000DE D7D6           03421         bra     i2clow          ; 7 Finish it up
                      03422 
                      03423       ifndef I2C_SCLOUT
                      03424 i2cckh  movff   RS2, FSR0H      ; 2 (13) Get pointer to clock pin
                      03425 i2chold incfsz  RR2, W          ; 1 Point to TRIS (never skip)
                      03426         movwf   FSR0L           ; 1
                      03427         bsf     FSR0L, 4        ; 1
                      03428         movf    RM2, W          ; 1
                      03429           ifndef I2C_HOLD
                      03430         bra     i2chigh         ; 7 Finish it up
                      03431           else
                      03432         iorwf   PREINC0, F      ; 1 Set high (input)
                      03433         movff   RR2, FSR0L      ; 2 Point back to port
                      03434         andwf   INDF0, W        ; 1 Isolate pin
                      03435         bz      i2chold         ; 1 / 2 Check for still low
                      03436         bra     i2chl           ; 4
                      03437           endif
                      03438       else
