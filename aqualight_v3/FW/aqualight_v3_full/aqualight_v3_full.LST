                      00011 ;******************************************************************
                      00087   LIST
                      00088 ; Oscillator is 16MHz
                      01493   LIST
000000                01494     ORG RESET_ORG               ; Reset vector at 0
                      01498   LIST
000000 6A00           01499         clrf    FLAGS           ; Clear all flags on reset
                      01503   LIST
000002 EFA4 F002      01504         goto    INIT            ; Finish initialization
                      03235   LIST
000006 8A00           03236 I2CREADS bsf    I2CSTOPFLAG     ; Indicate Stop after this byte
000008 AA00           03237         btfss   I2CSTOPFLAG     ; Skip next always
00000A 9A00           03238 I2CREAD bcf     I2CSTOPFLAG     ; Don't Stop
00000C B600           03239         btfsc   I2CREADFLAG     ; Already reading?
00000E D003           03240         bra     i2creadip       ; Yes
000010 8600           03241         bsf     I2CREADFLAG     ; Indicate read
000012 D844           03242         rcall   i2cstart        ; Send Start condition and command
000014 E227           03243         bc      i2cstop         ; No acknowledge
                      03244 
000016 0E08           03245 i2creadip movlw 8               ; 8 bits to a byte
000018 6E17           03246         movwf   R1 + 1          ; Bit counter
00001A D854           03247 i2creadloop rcall i2cgetbit     ; Get a bit
00001C 3616           03248         rlcf    R1, F           ; Put bit away
00001E 2E17           03249         decfsz  R1 + 1, F       ; Do next, if any
000020 D7FC           03250         bra     i2creadloop
000022 AA00           03251         btfss   I2CSTOPFLAG     ; Send stop?
000024 D82E           03252         rcall   i2cdal          ; No, send acknowledge
000026 D85C           03253         rcall   i2cckh          ; Toggle clock in any case
000028 D855           03254         rcall   i2cckl
00002A BA00           03255         btfsc   I2CSTOPFLAG     ; Send stop?
00002C D81B           03256         rcall   i2cstop         ; Yes, send Stop condition
00002E D821           03257         rcall   i2cdah          ; Make sure data ends up as input
000030 5016           03258         movf    R1, W           ; Get result to W
000032 90D8           03259         bcf     STATUS, C       ; Clear carry for OK return
000034 EFA1 F002      03260 i2creaddone goto DUNN
                      03326   LIST
000038 8A00           03327 I2CWRITES bsf   I2CSTOPFLAG     ; Indicate Stop after this byte
00003A AA00           03328         btfss   I2CSTOPFLAG     ; Skip next always
00003C 9A00           03329 I2CWRITE bcf    I2CSTOPFLAG     ; Don't Stop
00003E B400           03330         btfsc   I2CFIRSTFLAG    ; Check for first I2C char (command)
000040 D005           03331         bra     i2cwrite2       ; No
000042 0BFE           03332         andlw   0feh            ; Make sure r/w bit clear
000044 6E01           03333         movwf   GOP             ; Save command
000046 8400           03334         bsf     I2CFIRSTFLAG    ; Indicate not first anymore
000048 90D8           03335         bcf     STATUS, C       ; Clear carry for OK return
00004A D00A           03336         bra     i2cwritedone    ; That's it for now
                      03337 
00004C B800           03338 i2cwrite2 btfsc I2CWRITEFLAG    ; Already writing?
00004E D005           03339         bra     i2cwriteip      ; Yes
000050 6E1E           03340         movwf   R3              ; Save char
000052 8800           03341         bsf     I2CWRITEFLAG    ; Indicate write
000054 D823           03342         rcall   i2cstart        ; Send Start condition and command
000056 E206           03343         bc      i2cstop         ; No acknowledge
MPASM  5.43                 DANER_V3_FULL.ASM   4-5-2013  1:19:30         PAGE 11


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

000058 501E           03344         movf    R3, W           ; Get char back
00005A D827           03345 i2cwriteip rcall i2cwritec      ; Write character
00005C E203           03346         bc      i2cstop         ; No acknowledge
00005E AA00           03347         btfss   I2CSTOPFLAG     ; Send stop bit?
000060 EFA1 F002      03348 i2cwritedone goto DUNN          ; No
                      03349 
000064 D80E           03350 i2cstop rcall   i2cdal          ; 12 Start data low
000066 D83C           03351         rcall   i2cckh          ; 15 Set clock high (input)
000068 9400           03352         bcf     I2CFIRSTFLAG    ; 1 Reset first char flag
00006A 9800           03353         bcf     I2CWRITEFLAG    ; 1 No longer writing
00006C 9600           03354         bcf     I2CREADFLAG     ; 1 No longer reading either
00006E D801           03355         rcall   i2cdah          ; Set data high (input)
000070 D7F7           03356         bra     i2cwritedone
                      03357 
000072 C010 FFEA      03358 i2cdah  movff   RS1, FSR0H      ; 2 (11) Get pointer to data pin
000076 3C0E           03359         incfsz  RR1, W          ; 1 Point to TRIS (never skip, doesn't change flags)
000078 6EE9           03360         movwf   FSR0L           ; 1
00007A 88E9           03361         bsf     FSR0L, 4        ; 1
00007C 500C           03362         movf    RM1, W          ; 1
00007E 12EC           03363 i2chigh iorwf   PREINC0, F      ; 1 Set high (input)
000080 D008           03364         bra     i2chl           ; 2
                      03365 
000082 C010 FFEA      03366 i2cdal  movff   RS1, FSR0H      ; 2 (10) Get pointer to data pin
000086 C00E FFE9      03367         movff   RR1, FSR0L      ; 2
00008A 1C0C           03368         comf    RM1, W          ; 1
00008C 16EE           03369 i2clow  andwf   POSTINC0, F     ; 1 Set low, start pointing to TRIS
00008E 88E9           03370         bsf     FSR0L, 4        ; 1
000090 16EC           03371         andwf   PREINC0, F      ; 1 Set to output
000092                03372 i2chl
                      03373       ifndef I2C_SLOW
                      03374         return                  ; 2
                      03375       else
                      03376           if (OSC > 12)
000092 0E04           03377         movlw   (OSC) / 4       ; 1 Pause ~5us to slow to 100kHz without wrecking C
000094 6E12           03378         movwf   R0              ; 1
000096 2E12           03379 i2cslowloop decfsz R0, F        ; 1
000098 D7FE           03380         bra     i2cslowloop     ; 2
00009A 0012           03381         return                  ; 2
                      03382           else
                      03383         goto    DUNN            ; 6
                      03384           endif
                      03385       endif
                      03386 
00009C DFEA           03387 i2cstart rcall  i2cdah          ; 13 Make sure bus is idle
00009E D820           03388         rcall   i2cckh          ; 15
0000A0 DFF0           03389         rcall   i2cdal          ; 12 Send Start condition
0000A2 D818           03390         rcall   i2cckl          ; 14
0000A4 5001           03391         movf    GOP, W          ; 1 Get command
0000A6 B600           03392         btfsc   I2CREADFLAG     ; 1 / 2 Read?
0000A8 0901           03393         iorlw   1               ; 1 / 0 Yes, put in read bit
                      03394 
0000AA 6E16           03395 i2cwritec movwf R1              ; 1 Save data
0000AC 0E08           03396         movlw   8               ; 1 8 bits to send
MPASM  5.43                 DANER_V3_FULL.ASM   4-5-2013  1:19:30         PAGE 12


